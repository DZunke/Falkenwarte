# Shared, non-secret defaults loaded by Symfony Runtime.
# Use .env.local for machine-specific overrides. Real environment variables take precedence.
APP_ENV=dev
APP_SECRET=
APP_SETUP_TOKEN=

# Empty paths use var/ in a source checkout. The production container uses /data.
FALKENWARTE_DATA_DIR=
FALKENWARTE_DB=
FALKENWARTE_BACKUP_DIR=
FALKENWARTE_BACKUP_MAX_BYTES=5368709120
FALKENWARTE_PUBLIC_ORIGIN=https://localhost:8443
# Optional override for T3 OAuth callbacks, retained for existing installations.
FALKENWARTE_PUBLIC_URL=

# Empty hub URLs and issuer follow the configured public origin.
MERCURE_ISSUER=
MERCURE_PUBLIC_URL=
MERCURE_RESOURCE_IDENTIFIER=
MERCURE_INTERNAL_URL=
MERCURE_PUBLISHER_SECRET=
MERCURE_SUBSCRIBER_SECRET=
MERCURE_SUBSCRIBER_TTL=600

# Used only by the isolated test environment.
DECISIONS_TEST_ENDPOINT=
FALKENWARTE_TEST_CLOCK_FILE=
FALKENWARTE_TEST_STOP_BEFORE_INBOX=
