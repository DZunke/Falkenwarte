{
  "id": "falkenwarte.link-notes",
  "name": "Linknotizen",
  "description": "Ergänzt lokale Notizen zu registrierten Ticketlinks; externe Inhalte werden nicht abgerufen.",
  "version": "1.0.0",
  "contract_version": "1.0",
  "api_compatibility": {
    "backend": "^1.0",
    "frontend": "^1.0"
  },
  "backend": {
    "composer_package": "falkenwarte/link-notes",
    "definition_service": "Falkenwarte\\LinkNotes\\PluginDefinition"
  },
  "dependencies": [],
  "capabilities": [
    {
      "name": "links.notes",
      "implementation_id": "link_notes.panel",
      "settings_scope": "project"
    }
  ],
  "subscriptions": [
    {
      "event_type": "work.link_registered",
      "schema_version": 1,
      "consumer": "link_notes.projection",
      "replay_policy": "catch_up_bounded",
      "external_side_effects": false
    }
  ],
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled_labels": {
        "type": "array",
        "default": [],
        "items": {
          "type": "string"
        }
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "settings_schema_id": "https://falkenwarte.local/schemas/link-notes-settings-v1",
  "migrations": {
    "namespace": "Falkenwarte\\LinkNotes\\Migrations",
    "table_prefix": "plg_link_notes_",
    "data_version": 1
  },
  "ui": [
    {
      "slot": "task.tabs",
      "component_id": "link-notes.tab",
      "label": "Linknotizen",
      "required_capability": "links.notes"
    }
  ],
  "data_retention": {
    "on_disable": "preserve",
    "on_uninstall": "retain_by_default",
    "export_supported": true
  },
  "mcp_tools": [
    {
      "name": "link_notes_list",
      "description": "Lokale Notizen zu registrierten Ticketlinks lesen.",
      "operation_id": "task_link_notes_list",
      "required_plugin_capability": "links.notes",
      "required_capabilities": ["tasks.read"],
      "default_enabled": true,
      "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false},
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"task_id": {"type": "string", "format": "uuid"}},
        "required": ["task_id"]
      },
      "output_schema_ref": "openapi.yaml#/components/schemas/LinkNotePage"
    },
    {
      "name": "link_note_create",
      "description": "Eine lokale Notiz zu einem registrierten Ticketlink anlegen.",
      "operation_id": "task_link_note_create",
      "required_plugin_capability": "links.notes",
      "required_capabilities": ["links.notes.write"],
      "default_enabled": true,
      "annotations": {"readOnlyHint": false, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false},
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {"type": "string", "format": "uuid"},
          "link_id": {"type": "string", "format": "uuid"},
          "note": {"type": "string", "minLength": 1, "maxLength": 2000},
          "client_request_id": {"type": "string", "minLength": 8, "maxLength": 256},
          "expected_version": {"type": "integer", "minimum": 1}
        },
        "required": ["task_id", "link_id", "note", "client_request_id", "expected_version"]
      },
      "output_schema_ref": "openapi.yaml#/components/schemas/LinkNote"
    },
    {
      "name": "link_note_update",
      "description": "Eine lokale Linknotiz ändern; die Revision bleibt erhalten.",
      "operation_id": "task_link_note_update",
      "required_plugin_capability": "links.notes",
      "required_capabilities": ["links.notes.write"],
      "default_enabled": true,
      "annotations": {"readOnlyHint": false, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false},
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {"type": "string", "format": "uuid"},
          "note_id": {"type": "string", "format": "uuid"},
          "note": {"type": "string", "minLength": 1, "maxLength": 2000},
          "client_request_id": {"type": "string", "minLength": 8, "maxLength": 256},
          "expected_version": {"type": "integer", "minimum": 1}
        },
        "required": ["task_id", "note_id", "note", "client_request_id", "expected_version"]
      },
      "output_schema_ref": "openapi.yaml#/components/schemas/LinkNote"
    },
    {
      "name": "link_note_remove",
      "description": "Eine lokale Linknotiz entfernen und ihre Historie behalten.",
      "operation_id": "task_link_note_remove",
      "required_plugin_capability": "links.notes",
      "required_capabilities": ["links.notes.write"],
      "default_enabled": true,
      "annotations": {"readOnlyHint": false, "destructiveHint": true, "idempotentHint": true, "openWorldHint": false},
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {"type": "string", "format": "uuid"},
          "note_id": {"type": "string", "format": "uuid"},
          "client_request_id": {"type": "string", "minLength": 8, "maxLength": 256},
          "expected_version": {"type": "integer", "minimum": 1}
        },
        "required": ["task_id", "note_id", "client_request_id", "expected_version"]
      },
      "output_schema_ref": "openapi.yaml#/components/schemas/LinkNote"
    }
  ]
}
