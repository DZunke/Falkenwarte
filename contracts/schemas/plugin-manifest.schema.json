{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "contract_version": {
      "const": "1.0"
    },
    "api_compatibility": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "frontend": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "backend"
      ],
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "properties": {
        "composer_package": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
        },
        "definition_service": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "composer_package",
        "definition_service"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "plugin_id": {
            "type": "string",
            "minLength": 1
          },
          "version_constraint": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "plugin_id",
          "version_constraint"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "implementation_id": {
            "type": "string",
            "minLength": 1
          },
          "settings_scope": {
            "enum": [
              "global",
              "project"
            ]
          }
        },
        "required": [
          "name",
          "implementation_id",
          "settings_scope"
        ],
        "additionalProperties": false
      }
    },
    "subscriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_type": {
            "type": "string",
            "minLength": 1
          },
          "schema_version": {
            "type": "integer",
            "minimum": 1
          },
          "consumer": {
            "type": "string",
            "minLength": 1
          },
          "replay_policy": {
            "enum": [
              "skip",
              "catch_up_bounded"
            ]
          },
          "external_side_effects": {
            "type": "boolean"
          }
        },
        "required": [
          "event_type",
          "schema_version",
          "consumer",
          "replay_policy",
          "external_side_effects"
        ],
        "additionalProperties": false
      }
    },
    "settings_schema": {
      "type": [
        "object",
        "boolean"
      ]
    },
    "migrations": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "table_prefix": {
          "type": "string",
          "pattern": "^plg_[a-z0-9_]+_$"
        },
        "data_version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "namespace",
        "table_prefix",
        "data_version"
      ],
      "additionalProperties": false
    },
    "ui": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "enum": [
              "global.navigation",
              "project.tabs",
              "task.tabs",
              "dashboard.widgets",
              "task.actions",
              "settings.sections"
            ]
          },
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "required_capability": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string",
            "pattern": "^/extensions/[a-z0-9/_-]+$"
          }
        },
        "required": [
          "slot",
          "component_id",
          "label",
          "required_capability"
        ],
        "additionalProperties": false
      }
    },
    "data_retention": {
      "type": "object",
      "properties": {
        "on_disable": {
          "const": "preserve"
        },
        "on_uninstall": {
          "const": "retain_by_default"
        },
        "export_supported": {
          "type": "boolean"
        }
      },
      "required": [
        "on_disable",
        "on_uninstall",
        "export_supported"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "version",
    "contract_version",
    "api_compatibility",
    "backend",
    "dependencies",
    "capabilities",
    "subscriptions",
    "settings_schema",
    "migrations",
    "ui",
    "data_retention"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falkenwarte.local/schemas/plugin-manifest-v1",
  "title": "Trusted installed plugin manifest v1",
  "description": "Manifest is metadata, not an executable installer. Schema does not sandbox trusted PHP code."
}
