{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falkenwarte.local/schemas/action-event-v1",
  "title": "Action lifecycle event v1",
  "allOf": [
    {
      "$ref": "event-envelope.schema.json"
    },
    {
      "properties": {
        "kind": {
          "const": "action"
        },
        "event_type": {
          "enum": [
            "action.accepted",
            "action.started",
            "action.succeeded",
            "action.failed",
            "action.cancelled"
          ]
        },
        "data": {
          "type": "object",
          "properties": {
            "command_type": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "id"
              ],
              "additionalProperties": false
            },
            "result_resource": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "error_code": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "redacted_message": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            }
          },
          "required": [
            "command_type",
            "target",
            "result_resource",
            "error_code"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}
