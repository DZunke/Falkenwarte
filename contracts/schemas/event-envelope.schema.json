{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "domain",
        "action",
        "integration",
        "ui"
      ]
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]+$"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "owner",
            "agent",
            "system",
            "plugin"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "action_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregate_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "kind",
    "event_type",
    "schema_version",
    "occurred_at",
    "project_id",
    "actor",
    "correlation_id",
    "causation_id",
    "action_id",
    "aggregate",
    "data"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falkenwarte.local/schemas/event-envelope-v1",
  "title": "Falkenwarte event envelope v1",
  "description": "Proposed application contract; not a native T3 or Mercure payload.",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "domain"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "aggregate": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "type",
              "id",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "aggregate",
          "aggregate_sequence"
        ]
      }
    }
  ]
}
