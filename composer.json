{
  "name": "falkenwarte/app",
  "description": "Private single-user control platform for project work and T3 Code.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "~8.5.0",
    "ext-ctype": "*",
    "ext-fileinfo": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-pcntl": "*",
    "ext-sodium": "*",
    "ext-sqlite3": "*",
    "ext-zip": "*",
    "doctrine/dbal": "^4.6",
    "doctrine/doctrine-bundle": "^3.4",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/migrations": "^3.9",
    "league/commonmark": "^2.7",
    "mcp/sdk": "0.9.0",
    "nyholm/psr7": "^1.8",
    "opis/json-schema": "^2.4",
    "symfony/ai-bundle": "1.0.0-BETA1",
    "symfony/ai-open-ai-platform": "1.0.0-BETA1",
    "symfony/ai-open-responses-platform": "1.0.0-BETA1",
    "symfony/ai-platform": "1.0.0-BETA1",
    "symfony/console": "7.4.*",
    "symfony/clock": "7.4.*",
    "symfony/cache": "7.4.*",
    "symfony/config": "7.4.*",
    "symfony/dependency-injection": "7.4.*",
    "symfony/doctrine-bridge": "7.4.*",
    "symfony/doctrine-messenger": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/error-handler": "7.4.*",
    "symfony/event-dispatcher": "7.4.*",
    "symfony/filesystem": "7.4.*",
    "symfony/finder": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-foundation": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/http-kernel": "7.4.*",
    "symfony/lock": "7.4.*",
    "symfony/mcp-bundle": "1.0.0-BETA1",
    "symfony/mercure": "0.10.0",
    "symfony/mercure-bundle": "0.7.0",
    "symfony/messenger": "7.4.*",
    "symfony/options-resolver": "7.4.*",
    "symfony/password-hasher": "7.4.*",
    "symfony/process": "7.4.*",
    "symfony/property-access": "7.4.*",
    "symfony/property-info": "7.4.*",
    "symfony/psr-http-message-bridge": "7.4.*",
    "symfony/routing": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/security-core": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/security-http": "7.4.*",
    "symfony/serializer": "7.4.*",
    "symfony/stopwatch": "7.4.*",
    "symfony/string": "7.4.*",
    "symfony/translation": "7.4.*",
    "symfony/type-info": "7.4.*",
    "symfony/uid": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/workflow": "7.4.*",
    "symfony/web-link": "7.4.*",
    "symfony/twig-bridge": "7.4.*",
    "symfony/yaml": "7.4.*",
    "symfony/var-dumper": "7.4.*",
    "symfony/var-exporter": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "twig/twig": "^3.30"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.80",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^12.0",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/dom-crawler": "7.4.*",
    "symfony/phpunit-bridge": "7.4.*"
  },
  "conflict": {
    "doctrine/orm": "*",
    "symfony/orm-pack": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "DoctrineMigrations\\": "migrations/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\BackgroundFunctional\\": "tests/BackgroundFunctional/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/runtime": true
    },
    "bump-after-update": false,
    "platform": {
      "php": "8.5.0"
    },
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
